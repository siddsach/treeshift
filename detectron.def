Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu20.04

%labels
    Author tree-distribution-shift
    Description Detectron2 environment (Faster R-CNN + Mask R-CNN)
    Version 1.0

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export CUDA_HOME=/usr/local/cuda
    export FORCE_CUDA=1
    export TORCH_CUDA_ARCH_LIST="7.0 7.5 8.0 8.6 9.0+PTX"
    export PYTHONPATH=/workspace:${PYTHONPATH}

%post
    set -e

    export DEBIAN_FRONTEND=noninteractive
    export CUDA_HOME=/usr/local/cuda
    export FORCE_CUDA=1
    export TORCH_CUDA_ARCH_LIST="7.0 7.5 8.0 8.6 9.0+PTX"

    # System packages
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        && add-apt-repository -y ppa:deadsnakes/ppa \
        && apt-get update \
        && apt-get install -y --no-install-recommends \
        git wget ca-certificates \
        python3.9 python3.9-venv python3.9-dev \
        libglib2.0-0 libsm6 libxext6 libxrender1 libgl1-mesa-glx build-essential \
        ninja-build \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.9 /usr/bin/python
    wget -q https://bootstrap.pypa.io/get-pip.py -O /tmp/get-pip.py \
        && python3.9 /tmp/get-pip.py
    # setuptools<70 required: torch's cpp_extension uses pkg_resources (removed in >=70)
    pip install --upgrade pip "setuptools<70" wheel ninja

    # PyTorch 2.1.2 + CUDA 12.1
    pip install torch==2.1.2 torchvision==0.16.2 \
        --index-url https://download.pytorch.org/whl/cu121

    # tree-distribution-shift data package
    pip install tree-distribution-shift 2>/dev/null || \
        pip install "git+https://github.com/aadityabuilds/tree-shift-package.git@main" \
        2>/dev/null || true

    # Runtime deps
    pip install pandas scipy matplotlib opencv-python-headless pycocotools tqdm

    # detectron2: try prebuilt wheel first (fast), fall back to source build
    pip install detectron2 \
        -f https://dl.fbaipublicfiles.com/detectron2/wheels/cu121/torch2.1/index.html \
    || (
        echo "Prebuilt detectron2 wheel not found — building from source..."
        git clone --depth 1 \
            https://github.com/facebookresearch/detectron2.git /opt/detectron2
        pip install --no-build-isolation -e /opt/detectron2
    )

    git config --global --add safe.directory /workspace

    # Force numpy<2 last — tree-distribution-shift/opencv/datasets may have pulled numpy>=2
    pip install "numpy<2" --force-reinstall

    # Verify
    python -c "import detectron2; print('detectron2', detectron2.__version__, 'OK')"
    python -c "import torch; print('torch', torch.__version__, 'OK')"
    python -c "
import numpy as np
v = tuple(int(x) for x in np.__version__.split('.')[:2])
assert v < (2, 0), f'numpy {np.__version__} >= 2 — will break detectron2'
print('numpy', np.__version__, 'OK')
"

%files
    . /workspace

%runscript
    exec /bin/bash

%test
    python -c "import detectron2; print('detectron2 OK')"
    python -c "import torch; print('torch OK')"
    python -c "import tree_shift; print('tree_shift OK')"
    python -c "import numpy as np; assert tuple(int(x) for x in np.__version__.split('.')[:2]) < (2,0)"
    echo "All tests passed"
